{% macro badge(b) %}<span class="ttb-badge ttb-{{ b.shape }}{% if b.dark %} ttb-dark{% endif %}" style="background: {{ b.color }}">{{ b.n }}</span>{% endmacro %}

<div class="ttb">
{% if loading %}
  <div class="dimmed small">{{ 'LOADING' | translate }}</div>
{% else %}
  {% for s in stops %}
    <div class="ttb-stop">
      <div class="ttb-label">{{ s.name }}</div>
      {% for r in s.rows %}
        <div class="ttb-dep">
          {% if r.img %}
            <div class="ttb-vehicle"><img class="{% if r.img.tram %}ttb-img-tram{% endif %}" src="{{ r.img.src }}" alt="" onerror="this.parentNode.style.display='none'"></div>
          {% endif %}
          <div class="ttb-row">
            {{ badge(r.badge) }}
            <span class="ttb-dest">{{ r.headsign }}</span>
            <span class="ttb-first">{{ r.first }}</span>
            {% if r.next %}<span class="ttb-next">{{ r.next }}</span>{% endif %}
          </div>
        </div>
      {% else %}
        <div class="ttb-none">{{ 'NO_TRIP' | translate }}</div>
      {% endfor %}
    </div>
  {% endfor %}
  {% for a in alerts %}
    <div class="ttb-alert">
      {% for b in a.badges %}{{ badge(b) }}{% endfor %}
      <span>{{ a.title }}{% if a.period %} · {{ a.period }}{% endif %}</span>
    </div>
  {% endfor %}
{% endif %}
</div>
